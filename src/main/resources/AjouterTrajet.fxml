<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterTrajetController">

   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>

   <VBox alignment="CENTER" spacing="15" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
      <Label styleClass="title-label" text="Ajouter un Trajet" />

      <VBox spacing="5">
         <Label styleClass="info-label" text="Ville de Départ" />
         <TextField fx:id="depart_id" promptText="Ville de Départ" styleClass="text-field" />
         <Label fx:id="departErrorLabel" managed="false" styleClass="error-label" text="" visible="false" />
      </VBox>

      <VBox spacing="5">
         <Label styleClass="info-label" text="Ville d'Arrivée" />
         <TextField fx:id="destination_id" promptText="Ville d'Arrivée" styleClass="text-field" />
         <Label fx:id="destinationErrorLabel" managed="false" styleClass="error-label" text="" visible="false" />
      </VBox>

      <VBox spacing="5">
         <Label styleClass="info-label" text="Date de Départ" />
         <DatePicker fx:id="date_id" promptText="Date de Départ" styleClass="date-picker" />
         <Label fx:id="dateErrorLabel" managed="false" styleClass="error-label" text="" visible="false" />
      </VBox>

      <VBox spacing="5">
         <Label styleClass="info-label" text="Heure de Départ" />
         <TextField fx:id="heure_id" promptText="HH:MM" styleClass="text-field" />
         <Label fx:id="heureErrorLabel" managed="false" styleClass="error-label" text="" visible="false" />
      </VBox>

      <VBox spacing="5">
         <Label styleClass="info-label" text="Prix par Passager (TND)" />
         <TextField fx:id="prix_id" promptText="Prix" styleClass="text-field" />
         <Label fx:id="prixErrorLabel" managed="false" styleClass="error-label" text="" visible="false" />
      </VBox>

      <VBox spacing="5">
         <Label styleClass="info-label" text="Nombre de Places" />
         <TextField fx:id="place_id" promptText="Nombre de Places" styleClass="text-field" />
         <Label fx:id="placeErrorLabel" managed="false" styleClass="error-label" text="" visible="false" />
      </VBox>

      <VBox spacing="5">
         <Label styleClass="info-label" text="Bagage" />
         <ComboBox fx:id="bagage_id" promptText="Type de Bagage" styleClass="combo-box" />
         <Label fx:id="bagageErrorLabel" managed="false" styleClass="error-label" text="" visible="false" />
      </VBox>

      <HBox alignment="CENTER" spacing="10">
         <Button onAction="#ajoutertrajet" styleClass="action-button, add-button" text="Enregistrer" />
         <Button onAction="#annulertrajet" styleClass="action-button, back-button" text="Annuler" />
      </HBox>
   </VBox>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</AnchorPane>
