<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" prefHeight="653.0" prefWidth="1046.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" styleClass="custom-scroll" translateX="15.0" translateY="9.0" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PostDetailControllerAdmin">
    <content>
        <VBox fx:id="rootContainer" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="1000" minHeight="-Infinity" minWidth="-Infinity" prefWidth="1022.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20;" styleClass="post-detail">
            <children>
                <!-- Back button -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBackButton" styleClass="back-button" text="Retour">
                            <graphic>
                                <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="/Assets/default.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </HBox>

                <!-- Post image -->
                <ImageView fx:id="postImage" fitHeight="250.0" fitWidth="500.0" pickOnBounds="true" preserveRatio="true">
                    <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                    </VBox.margin>
                </ImageView>

                <!-- Title and date -->
                <VBox alignment="CENTER">
                    <children>
                        <Label fx:id="titleLabel" styleClass="post-title" text="Titre de la publication">
                            <font>
                                <Font name="Montserrat Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label fx:id="dateLabel" styleClass="post-date" text="01/01/2024">
                            <font>
                                <Font name="System Italic" size="14.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Label>
                    </children>
                </VBox>

                <!-- Post content -->
                <VBox alignment="CENTER_LEFT" styleClass="post-content">
                    <children>
                        <Label fx:id="contentLabel" styleClass="post-text" text="Contenu complet de la publication..." wrapText="true">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </padding>
                </VBox>



                <!-- Comments section -->
                <VBox fx:id="commentSection" spacing="10.0" style="-fx-background-color: transparent;">
                    <children>
                        <!-- Comment input area - initially hidden -->
                        <HBox fx:id="commentInputContainer" alignment="CENTER" spacing="5.0">
                            <children>
                                <TextArea fx:id="commentArea" prefHeight="60.0" promptText="Ajouter un commentaire..." style="-fx-background-radius: 5; -fx-border-radius: 5;" wrapText="true" HBox.hgrow="ALWAYS" />
                                <Button fx:id="sendCommentButton" mnemonicParsing="false" onAction="#handleSendComment" styleClass="send-comment-button" text="Envoyer" />
                            </children>
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </HBox>

                        <!-- Container for existing comments - always visible -->
                        <Label styleClass="comments-header" text="Commentaires">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="5.0" />
                            </VBox.margin>
                        </Label>
                        <VBox fx:id="commentsContainer" spacing="10.0" styleClass="comments-container">
                            <!-- Comments will be added here dynamically -->
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </VBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </content>
</ScrollPane>
