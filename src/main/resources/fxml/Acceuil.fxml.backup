<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.AcceuilController"
            stylesheets="@/css/style.css">

    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="sidebar" prefWidth="200">
            <!-- Profile Section -->
            <VBox styleClass="profile-section" alignment="CENTER" spacing="10">
                <ImageView fitWidth="100" fitHeight="100" preserveRatio="true">
                    <image>
                        <Image url="@/images/profile.png"/>
                    </image>
                </ImageView>
                <Label text="Welcome" styleClass="profile-name"/>
            </VBox>

            <!-- Navigation Menu -->
            <VBox styleClass="nav-menu" spacing="10">
                <Button text="Home" onAction="#allerAccueil" styleClass="nav-button"/>
                <Button text="Add Event" onAction="#allerAjouterEvenement" styleClass="nav-button"/>
                <Button text="View Events" onAction="#allerAfficherEvenement" styleClass="nav-button"/>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            <HBox spacing="10" alignment="TOP_RIGHT">
                <Button text="Ajouter" onAction="#allerAjouterEvenement"/>
                <Button text="Afficher" onAction="#allerAfficherEvenement"/>
            </HBox>

            <ScrollPane fitToWidth="true" fitToHeight="true">
                <VBox fx:id="eventsList" spacing="10">
                    <!-- Events will be added dynamically here -->
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
