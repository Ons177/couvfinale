<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.AfficherEvenementController"
      styleClass="main-background"
      spacing="10"
      stylesheets="@/css/style.css"
      style="-fx-padding: 20;">

    <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30;"
          alignment="TOP_CENTER"
          spacing="20">

        <Label fx:id="titleLabel"
               text="📅 Liste des Événements"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"
               alignment="CENTER"/>

        <VBox fx:id="eventDetails"
              style="-fx-background-color: #f0f0f0; -fx-padding: 20; -fx-background-radius: 5;">
            <!-- Event details will be added dynamically here -->
        </VBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Modifier" onAction="#modifierEvenement"/>
            <Button text="Supprimer" onAction="#supprimerEvenement"/>
            <Button text="Retour Accueil" onAction="#retourAccueil"/>
        </HBox>

    </VBox>
</VBox>


