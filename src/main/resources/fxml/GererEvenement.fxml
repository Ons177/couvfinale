<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400" prefWidth="600" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.GererEvenementController">
    <VBox spacing="20" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30" AnchorPane.topAnchor="30">
        <Label fx:id="titreLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <Label fx:id="descriptionLabel" />
        <Label fx:id="lieuLabel" />
        <Label fx:id="dateLabel" />
        <Label fx:id="heureLabel" />

        <HBox spacing="20">
            <Button onAction="#accepterEvenement" text="Accepter" />
            <Button onAction="#refuserEvenement" text="Refuser" />
        </HBox>
    </VBox>
</AnchorPane>
