<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="543.0" prefWidth="1367.0" styleClass="main-background" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ConsulterReservationController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 20;">
            <Button fx:id="retourAccueil" onAction="#retourAccueil" styleClass="back-button" text="Retour" />
            <Label styleClass="title-label" text="Liste des Réservations" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" prefHeight="440.0" prefWidth="1351.0" style="-fx-padding: 20;">
            <VBox fx:id="reservationsList" spacing="15">
                <children>
                    <TableView fx:id="tableReservation" prefHeight="400" prefWidth="1236.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colEvent" prefWidth="199.9999656677246" text="Événement" />
                            <TableColumn fx:id="colUser" minWidth="0.0" prefWidth="209.6000518798828" text="Utilisateur" />
                            <TableColumn fx:id="colPlaces" prefWidth="186.39996337890625" text="Places" />
                            <TableColumn fx:id="colDate" minWidth="0.0" prefWidth="214.4000244140625" text="Date Réservation" />
                            <TableColumn fx:id="colStatut_reservation" minWidth="0.0" prefWidth="181.5999755859375" text="Statut" />
                            <TableColumn fx:id="colPrix" minWidth="0.0" prefWidth="136.00006103515625" text="Prix" />
                            <TableColumn fx:id="colActions" prefWidth="198.4000244140625" text="Actions" />
                        </columns>
                    </TableView>
                </children></VBox>
        </ScrollPane>
    </center>

</BorderPane>
