            <ScrollPane fitToWidth="true" prefHeight="661.0" prefWidth="1084.0" style="-fx-background-color:transparent;">
               <content>
                  <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                     <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="500.0">
                           <children>
                              <Label prefHeight="60.0" prefWidth="407.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Détails réclamation" />
                           </children>
                        </HBox>

                        <Line endX="900.0" startX="40.0" stroke="#e2e8f0" />

                        <VBox spacing="24">
                           <HBox spacing="16">
                              <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A5568;" text="Nom :" />
                              <Label fx:id="NomUser" style="-fx-font-size: 15px; -fx-text-fill: #2D3748;" />
                           </HBox>
                           <HBox spacing="16">
                              <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A5568;" text="Prénom :" />
                              <Label fx:id="PrenomUser" style="-fx-font-size: 15px; -fx-text-fill: #2D3748;" />
                           </HBox>
                           <HBox spacing="16">
                              <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A5568;" text="Type :" />
                              <Label fx:id="TypeRecDetail" style="-fx-font-size: 15px; -fx-text-fill: #2D3748;" wrapText="true" />
                           </HBox>
                           <HBox spacing="16">
                              <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A5568;" text="Description :" />
                              <Label fx:id="DescRecDetail" prefWidth="500" style="-fx-font-size: 15px; -fx-text-fill: #2D3748;" wrapText="true" />
                           </HBox>
                           <HBox spacing="16">
                              <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A5568;" text="Date :" />
                              <Label fx:id="DateRecDetail" style="-fx-font-size: 15px; -fx-text-fill: #2D3748;" />
                           </HBox>
                           <HBox spacing="16">
                              <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A5568;" text="Priorité :" />
                              <Label fx:id="PrioriteRecDetail" style="-fx-font-size: 15px; -fx-text-fill: #2D3748;" />
                           </HBox>
                           <HBox spacing="16">
                              <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A5568;" text="Statut :" />
                              <Label fx:id="StatutRecDetail" style="-fx-font-size: 15px; -fx-text-fill: #2D3748;" />
                           </HBox>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="500.0">
                           <children>
                              <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Réponse" />
                           </children>
                        </HBox>

                        <VBox spacing="16" style="-fx-background-color: #F7FAFC; -fx-background-radius: 12; -fx-padding: 16;">
                           <HBox spacing="10">
                              <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A5568;" text="Contenu : " />
                              <Label fx:id="ContenuRep" prefWidth="680" style="-fx-font-size: 15px; -fx-text-fill: #2D3748;" wrapText="true" />
                           </HBox>
                           <HBox spacing="10">
                              <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A5568;" text="Date : " />
                              <Label fx:id="DateRep" style="-fx-font-size: 15px; -fx-text-fill: #2D3748;" />
                           </HBox>
                        </VBox>

                        <VBox spacing="16">
                           <HBox spacing="10">
                              <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A5568;" text="Réaction :" />
                              <Label fx:id="labelReaction" style="-fx-font-size: 15px; -fx-text-fill: #2D3748;" />
                           </HBox>
                           <HBox spacing="10">
                              <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A5568;" text="Date réaction :" />
                              <Label fx:id="labelDateReaction" style="-fx-font-size: 15px; -fx-text-fill: #2D3748;" />
                           </HBox>
                        </VBox>

                        <HBox alignment="BOTTOM_RIGHT" spacing="20.0">
                           <children>
                              <Button fx:id="AnnulerDetailReclamationVoirRepondusAdmin" mnemonicParsing="false" onAction="#OnAnnulerDetailReclamationVoirRepondusAdmin" prefHeight="50.0" prefWidth="150.0" styleClass="button-red" text="Annuler" />
                              <Button fx:id="SupprimerReponse" mnemonicParsing="false" onAction="#OnSupprimerReponse" prefHeight="50.0" prefWidth="86.0" styleClass="button-blue">
                                 <graphic>
                                    <ImageView fitHeight="29.0" fitWidth="30.0" preserveRatio="true">
                                       <image><Image url="@../images/supprimer.png" /></image>
                                    </ImageView>
                                 </graphic>
                              </Button>
                              <Button fx:id="ModifierReponse" mnemonicParsing="false" onAction="#OnModifierReponse" prefHeight="50.0" prefWidth="86.0" styleClass="button-blue">
                                 <graphic>
                                    <ImageView fitHeight="28.0" fitWidth="27.0" preserveRatio="true">
                                       <image><Image url="@../images/editer.png" /></image>
                                    </ImageView>
                                 </graphic>
                              </Button>
                           </children>
                           <padding><Insets bottom="10.0" right="10.0" /></padding>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </Pane>
   </children>
   <stylesheets>
      <URL value="@../styles/AccueilRec.css" />
      <URL value="@../styles/AjoutRec.css" />
   </stylesheets>
