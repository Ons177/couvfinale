<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.AjouterEvenementController"
      styleClass="main-background"
      spacing="20" style="-fx-padding: 20;"
      stylesheets="@/css/style.css">

    <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30;" alignment="TOP_CENTER" spacing="20">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Ajouter un Événement"
                   style="-fx-background-color: #b3d8f7; -fx-background-radius: 10; -fx-padding: 10 30; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                <image>
                    <Image url="@/images/smartrides.png"/>
                </image>
            </ImageView>
        </HBox>
        <VBox spacing="15">
            <TextField fx:id="titreField" promptText="Titre de l'événement" />
            <TextArea fx:id="descriptionArea" promptText="Description" />
            <TextField fx:id="lieuField" promptText="Lieu" />
            <DatePicker fx:id="dateDebutPicker" promptText="Date début" />
            <DatePicker fx:id="dateFinPicker" promptText="Date fin" />
            <TextField fx:id="heureField" promptText="Heure (ex: 14:00:00)" />
            <TextField fx:id="idCreateurField" promptText="ID Créateur (int)" />
            <TextField fx:id="typeEvenementField" promptText="Type d'événement" />
        </VBox>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="ajouterBtn" onAction="#ajouterEvenement" text="Ajouter" styleClass="add-button"/>
            <Button fx:id="accueilBtn" onAction="#alleraccueil" text="Accueil" styleClass="add-button"/>
        </HBox>
    </VBox>

</VBox>
