<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="postCard" prefHeight="377.0" prefWidth="320.0" styleClass="post-card" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PostCardAdmin">
    <children>
        <ImageView fx:id="postImage" fitHeight="154.0" fitWidth="254.0" pickOnBounds="true" preserveRatio="true" translateX="35.0" translateY="20.0" />
        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" styleClass="post-content" translateY="15.0">
            <children>
                <Label fx:id="titleLabel" styleClass="post-title" text="Post Title">
                    <font>
                        <Font name="Montserrat SemiBold" size="18.0" />
                    </font>
                </Label>
                <Label fx:id="dateLabel" styleClass="post-date" text="01/01/2024">
                    <VBox.margin>
                        <Insets top="5.0" />
                    </VBox.margin>
                </Label>
                <Label fx:id="descriptionLabel" prefHeight="65.0" prefWidth="233.0" styleClass="post-description" text="jidszj" textAlignment="CENTER" wrapText="true">
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
                    <padding>
                        <Insets left="10.0" right="10.0" />
                    </padding>
                </Label>

                <!-- Comment section (initially hidden) -->
                <VBox fx:id="commentSection" managed="false" styleClass="comment-section" visible="false">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                    <children>


                        <!-- Container for comments -->
                        <VBox fx:id="commentsContainer" spacing="5.0">
                            <padding>
                                <Insets top="5.0" />
                            </padding>
                        </VBox>

                        <!-- View All Comments Button -->
                        <Button fx:id="viewCommentsButton" mnemonicParsing="false" onAction="#handleViewComments" styleClass="view-comments-button" text="View All Comments">
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                    </padding>
                </VBox>
            </children>
            <padding>
                <Insets bottom="15.0" left="10.0" right="10.0" top="15.0" />
            </padding>
        </VBox>
    </children>
</VBox>
