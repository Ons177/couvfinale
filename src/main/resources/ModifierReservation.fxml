<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ModifierReservationController"
            style="-fx-background-color: #e0e7ff;">

    <stylesheets>
        <URL value="@styldonia.css" />
    </stylesheets>

    <VBox alignment="CENTER" spacing="20"
          AnchorPane.bottomAnchor="20.0"
          AnchorPane.leftAnchor="20.0"
          AnchorPane.rightAnchor="20.0"
          AnchorPane.topAnchor="20.0">

        <!-- Titre -->
        <Label styleClass="big-title" text="✏️ Modifier votre Réservation" />

        <!-- Formulaire -->
        <GridPane alignment="CENTER" hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints />
                <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>

            <Label styleClass="info-label" text="Nom Passager :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="nomPassagerField" promptText="Nom" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label styleClass="info-label" text="Prénom Passager :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="prenomPassagerField" promptText="Prénom" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label styleClass="info-label" text="Email :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="emailField" promptText="Email" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label styleClass="info-label" text="Téléphone :" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="telephoneField" promptText="Téléphone" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label styleClass="info-label" text="Nombre de Places :" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="nombrePlacesField" promptText="Ex: 2" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label styleClass="info-label" text="Trajet :" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <ComboBox fx:id="trajetComboBox" promptText="Choisir un trajet" styleClass="combo-box" GridPane.columnIndex="1" GridPane.rowIndex="5" />
        </GridPane>

        <!-- Boutons -->
        <HBox alignment="CENTER" spacing="20">
            <Button onAction="#modifierReservation" styleClass="green-button" text="✅ Modifier" />
            <Button onAction="#annuler" styleClass="red-button" text="❌ Annuler" />
        </HBox>
    </VBox>
</AnchorPane>
