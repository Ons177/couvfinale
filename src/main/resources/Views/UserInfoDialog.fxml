<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400" prefWidth="400" style="-fx-padding: 20;" styleClass="bg" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UserInfoDialogController">
    <VBox alignment="CENTER_LEFT" spacing="10" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="👤 Informations de l'utilisateur" textAlignment="CENTER" textFill="#041759" />
        <Label fx:id="nomLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <Label fx:id="prenomLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <Label fx:id="emailLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <Label fx:id="roleLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <Label fx:id="telephoneLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <Label fx:id="ageLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <Label fx:id="cinLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <Label fx:id="permisLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <Button onAction="#handleClose" prefHeight="36.0" prefWidth="125.0" style="-fx-text-fill: white;" styleClass="bg" stylesheets="@style.css" text="Fermer" />

    </VBox>
</AnchorPane>
