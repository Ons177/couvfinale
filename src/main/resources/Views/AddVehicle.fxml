<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane style="-fx-background-color: #1e90ff;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="controllers.AddVehicleController">

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-background-radius: 10;" styleClass="bg" stylesheets="@style.css">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <Text style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Ajouter un véhicule" />

            <GridPane hgap="10" vgap="10">
                <Label text="Marque" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="marqueField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Modèle" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="modeleField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Couleur" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="couleurField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Matricule" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="matriculeField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Nombre de places" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <Spinner fx:id="placesSpinner" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </GridPane>

            <Button fx:id="addVehicleButton" style="-fx-background-color: #1e90ff; -fx-text-fill: white;" text="Ajouter le véhicule" />

            <!-- Panel de détails du véhicule -->
            <VBox fx:id="vehicleDetailsPanel" alignment="CENTER" spacing="20" style="-fx-background-radius: 10;" styleClass="bg" visible="false">
                <Text style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Détails du véhicule" />
                <Label fx:id="vehicleDetailsLabel" style="-fx-font-size: 18px;" />
            </VBox>
        </VBox>
    </center>
</BorderPane>

