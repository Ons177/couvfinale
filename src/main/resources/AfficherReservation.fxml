<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="740.0" prefWidth="1300.0" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AfficherReservationController">

    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

    <VBox spacing="20" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <!-- Title Section -->
        <VBox alignment="CENTER" spacing="20">
            <Label styleClass="title-label" text="Liste des Réservations" />
        </VBox>

        <!-- Empty state - shown when there are no reservations -->
        <VBox fx:id="emptyState" managed="false" styleClass="empty-state" visible="false">
            <Label styleClass="empty-state-text" text="Aucune réservation disponible" />
        </VBox>

        <!-- Scrollable Reservation Container -->
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <FlowPane fx:id="reservationContainer" alignment="CENTER" hgap="24" styleClass="evenement-list" vgap="24">
            </FlowPane>
        </ScrollPane>

        <!-- Action Buttons -->
        <HBox alignment="CENTER" spacing="20">
            <Button onAction="#retourAccueil" styleClass="action-button, back-button" text="Retour" />
        </HBox>
    </VBox>
</AnchorPane>
