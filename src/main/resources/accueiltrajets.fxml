      <Button fx:id="voirMesTrajetsBtn" layoutX="487.0" layoutY="39.0" onAction="#ouvrirAfficherTrajet" prefHeight="50.0" prefWidth="163.0" text="Voir les trajets" />
      <Button fx:id="ouvrirReservationbtn" layoutX="270.0" layoutY="39.0" mnemonicParsing="false" onAction="#afficherreservation" prefHeight="50.0" prefWidth="202.0" text="voir les reservations" />
   </children>
</AnchorPane>