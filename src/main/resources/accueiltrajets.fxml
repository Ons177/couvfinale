            </HBox>
            <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="615.0" prefWidth="1021.0">
               <content>
                  <FlowPane fx:id="flowpaneaccueil" hgap="24" prefHeight="1000.0" prefWidth="1000.0" prefWrapLength="900.0" styleClass="dash__container-card" vgap="24" />
