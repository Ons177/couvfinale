<AnchorPane prefHeight="765.0" prefWidth="1021.0" styleClass="bg" stylesheets="@accueilcsstra.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.accueiltrajetcontrolleur">
