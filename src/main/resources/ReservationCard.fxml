<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="reservationItem"
      maxWidth="380" minHeight="300" prefWidth="380" spacing="15"
      style="-fx-background-color: #f0f0f0;
             -fx-background-radius: 12;
             -fx-padding: 20;
             -fx-border-color: #cccccc;
             -fx-border-width: 1;
             -fx-border-radius: 12;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0.3, 0, 2);"
      xmlns="http://javafx.com/javafx/21.0.2"
      xmlns:fx="http://javafx.com/fxml/1">

    <VBox spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Nom:" style="-fx-font-weight: bold;" />
            <Label fx:id="nomLabel" wrapText="true" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Prénom:" style="-fx-font-weight: bold;" />
            <Label fx:id="prenomLabel" wrapText="true" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Email:" style="-fx-font-weight: bold;" />
            <Label fx:id="emailLabel" wrapText="true" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Téléphone:" style="-fx-font-weight: bold;" />
            <Label fx:id="telephoneLabel" wrapText="true" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Places:" style="-fx-font-weight: bold;" />
            <Label fx:id="placesLabel" wrapText="true" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Date:" style="-fx-font-weight: bold;" />
            <Label fx:id="dateLabel" wrapText="true" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Trajet:" style="-fx-font-weight: bold;" />
            <Label fx:id="trajetLabel" wrapText="true" />
        </HBox>
    </VBox>

    <HBox fx:id="actionsContainer" alignment="CENTER" spacing="10">
        <Button fx:id="modifierButton" text="Modifier"
                style="-fx-background-color: #4CAF50;
                       -fx-text-fill: white;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;" />
        <Button fx:id="supprimerButton" text="Supprimer"
                style="-fx-background-color: #F44336;
                       -fx-text-fill: white;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;" />
    </HBox>

</VBox>
