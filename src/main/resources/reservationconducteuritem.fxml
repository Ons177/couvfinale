<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="300.0" spacing="15" stylesheets="@styles/condres.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.reservationconducteurcontrolleur">
    <children>
        <Label fx:id="titreAnnoncecr" prefHeight="30.0" prefWidth="294.0" styleClass="label-info" text="Titre de l'annonce" />
        <Label fx:id="dateReservationcr" prefHeight="30.0" prefWidth="283.0" styleClass="label-info" text="Date de réservation" />
        <Label fx:id="dateDebutcr" prefHeight="30.0" prefWidth="290.0" styleClass="label-info" text="Début" />
        <Label fx:id="dateFincr" prefHeight="30.0" prefWidth="288.0" styleClass="label-info" text="Fin" />
        <Label fx:id="statutcr" prefHeight="30.0" prefWidth="288.0" styleClass="label-info" text="Statut" />
        <Button fx:id="detailsBtn" mnemonicParsing="false" onAction="#voirDetails" prefHeight="40.0" prefWidth="200.0" styleClass="button-details" text="Voir détails" />
        <Button mnemonicParsing="false" onAction="#accepterReservation" prefHeight="40.0" prefWidth="200.0" styleClass="button-accepter" text="Accepter" />
        <Button mnemonicParsing="false" onAction="#refuserReservation" prefHeight="40.0" prefWidth="200.0" styleClass="button-refuser" text="Refuser" />
    </children>
</VBox>
