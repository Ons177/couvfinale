<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="740.0" prefWidth="1300.0"
            xmlns="http://javafx.com/javafx/21.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AfficherTrajetController"
            styleClass="fb-background">

    <stylesheets>
        <URL value="@styldonia.css" />
    </stylesheets>

    <VBox spacing="20"
          AnchorPane.topAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          alignment="TOP_CENTER">

        <padding>
            <Insets top="20" left="20" right="20" bottom="20"/>
        </padding>

        <!-- Titre -->
        <Label styleClass="title-label" text="🚌 Liste des Trajets" />

        <!-- Affichage vide -->
        <VBox fx:id="emptyState" managed="false" visible="false" alignment="CENTER" spacing="10">
            <ImageView fitHeight="120" fitWidth="120" preserveRatio="true">
                <image>
                    <Image url="@icons/empty-trajet.png" />
                </image>
            </ImageView>
            <Label text="Aucun trajet disponible" styleClass="empty-state-text" />
        </VBox>

        <!-- Liste scrollable avec fond blanc -->
        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <FlowPane fx:id="trajetContainer"
                      hgap="24" vgap="24"
                      alignment="CENTER"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;" />
        </ScrollPane>

        <!-- Bouton retour -->
        <HBox alignment="CENTER" spacing="20">
            <Button text="Retour"
                    onAction="#retourAccueil"
                    styleClass="button-retour" />
        </HBox>
    </VBox>
</AnchorPane>
